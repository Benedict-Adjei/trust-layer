# Backend only. Copy to backend/.env; never put these values in frontend/.env.
# Leave disabled until you choose to permit real requests / provider usage.
FEATHERLESS_ENABLED=false
FEATHERLESS_API_KEY=
# Use an available instruction-tuned model ID from the Featherless catalog.
FEATHERLESS_MODEL=
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
# Overall deadline, including connection and response reads: 0.5–8 seconds.
FEATHERLESS_TIMEOUT_SECONDS=4
# Optional: absolute path to a separate local audit database.
# TRUSTLAYER_DB_PATH=C:\path\to\trustlayer.sqlite3
